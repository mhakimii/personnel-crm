{
  "name": "personnel-crm",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "spa": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personnel-crm",
      "database_id": "local"
    }
  ]
}
