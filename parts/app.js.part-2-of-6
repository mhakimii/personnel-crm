  $('#root').innerHTML = `
  <div class="layout">
    <aside class="sidebar">
      <div class="sb-head">
        <div class="sb-logo">${ICONS.personnel}</div>
        <div class="sb-title">مدیریت پرسنل و انبار<small>سامانه سازمانی</small></div>
      </div>
      <nav class="nav">
        ${NAV.map(n => {
    if (n.sec) {
      const items = NAV.filter(m => m.path && (m.key !== 'users' || AppState.user.role === 'admin'));
      return n.sec === 'مدیریت' && AppState.user.role !== 'admin' ? '' : `<div class="nav-sec">${n.sec}</div>`;
    }
    if (n.key === 'users' && AppState.user.role !== 'admin') return '';
    const active = page === n.key ? 'active' : '';
    return `<a class="nav-item ${active}" href="${n.path}">${ICONS[n.icon]}<span>${n.label}</span></a>`;
  }).join('')}
      </nav>
      <div class="sb-foot">
        <div class="sb-user">
          <div class="n">${esc(AppState.user.name)}</div>
          <div class="r">${ROLE_LBL}</div>
        </div>
        <button class="icon-btn" id="btn-logout" title="خروج">${ICONS.logout}</button>
      </div>
  </aside>
    <div class="main">
      <div class="topbar">
        <div class="page-title" id="page-title"></div>
        <div class="today-lbl" id="today-lbl"></div>
      </div>
      <div class="content" id="page"></div>
    </div>
  </div>`;
  $('#btn-logout').onclick = async () => {
    await api('POST', '/api/logout');
    AppState.user = null;
    AppState.canWrite = [];
    location.hash = '';
    render();
  };
  const titleMap = Object.fromEntries(NAV.filter(n => n.key).map(n => [n.key, n.label]));
  $('#page-title').textContent = titleMap[page] || 'داشبورد';
  $('#today-lbl').textContent = 'امروز: ' + JDate.format(JDate.today());
}

const ROLE_LBL = () => ROLE_FA[AppState.user.role];

function render() {
  if (!AppState.user) { renderLogin(); return; }
  if (!location.hash) location.hash = '#/dashboard';
  renderShell();
  const page = (location.hash.split('/')[1] || 'dashboard');
  const views = { dashboard: viewDashboard, attendance: viewAttendance, deliveries: viewDeliveries, reports: viewReports, personnel: viewPersonnel, contractors: viewContractors, projects: viewProjects, items: viewItems, users: viewUsers };
  (views[page] || viewDashboard)().catch(er => {
    $('#page').innerHTML = `<div class="card card-pad" style="color:var(--danger)">${esc(er.message)}</div>`;
    if (String(er.message).includes('ابتدا وارد شوید')) { AppState.user = null; render(); }
  });
}
window.addEventListener('hashchange', () => { if (AppState.user) render(); });
render();

// ---------- اجزای جدول ----------
function tableWrap(headers, rowsHtml, emptyMsg = 'موردی ثبت نشده است.') {
  return `
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr>${headers.map(h => `<th>${h}</th>`).join('')}</tr></thead>
      <tbody>${rowsHtml}</tbody>
    </table>
    ${rowsHtml ? '' : `<div class="empty">${emptyMsg}</div>`}
  </div>`;
}

// ============ داشبورد ============
async function viewDashboard() {
  const s = await api('GET', '/api/stats');
  const cards = [
    { ic: 'project', v: s.projects, l: 'پروژه فعال' },
    { ic: 'contractor', v: s.contractors, l: 'پیمانکار فعال' },
    { ic: 'personnel', v: s.personnel, l: 'پرسنل فعال' },
    { ic: 'attendance', v: s.presentToday, l: 'حاضرین امروز' },
    { ic: 'warehouse', v: s.deliveriesToday, l: 'تحویل امروز' },
    { ic: 'reports', v: s.reportsToday, l: 'گزارش امروز' }
  ];
  const maxN = Math.max(1, ...s.byProject.map(p => p.n));
  $('#page').innerHTML = `
  <div class="stat-grid">
    ${cards.map((c, i) => `
    <a href="#/${{ 0: 'projects', 1: 'contractors', 2: 'personnel', 3: 'attendance', 4: 'deliveries', 5: 'reports' }[i]}" style="text-decoration:none;color:inherit">
      <div class="stat">
        <div class="ic">${ICONS[c.ic]}</div>
        <div><div class="v">${toFa(c.v)}</div><div class="l">${c.l}</div></div>
      </div>
    </a>`).join('')}
  </div>
  <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:16px" class="dash-2col">
    <div class="card">
      <div class="card-head"><h3>حاضرین امروز بر اساس پروژه</h3><span class="hint">${JDate.format(s.today)}</span></div>
      <div class="card-pad">
        ${s.byProject.length ? s.byProject.map(p => `
          <div class="bar-row">
            <div class="bl">${esc(p.name)}</div>
            <div class="bt"><div class="bf" style="width:${Math.round(p.n / maxN * 100)}%"></div></div>
            <div class="bv">${toFa(p.n)}</div>
          </div>`).join('') : '<div class="empty">برای امروز حضور ثبت نشده است.</div>'}
      </div>
    </div>
    <div class="card">
      <div class="card-head"><h3>اقلام تحویل‌شده این ماه</h3></div>
      <div class="card-pad">
        <div class="mini-list">
          <div class="mini-row"><span>تعداد رکوردهای تحویل</span><b>${toFa(s.deliveriesMonth)}</b></div>
          <div class="mini-row"><span>مجموع مقادیر تحویل‌شده</span><b>${toFa(Number(s.deliveriesMonthQty).toLocaleString('en-US'))}</b></div>
          <div class="mini-row"><span>تحویل‌های امروز</span><b>${toFa(s.deliveriesToday)}</b></div>
          <div class="mini-row"><span>گزارش‌های روزانه امروز</span><b>${toFa(s.reportsToday)}</b></div>
        </div>
      </div>
    </div>
  </div>`;

}

// ============ حضور و غیاب ============
async function viewAttendance() {
  const [projects, contractors] = await Promise.all([
    api('GET', '/api/projects'),
    api('GET', '/api/contractors')
  ]);
  const today = JDate.today();
  $('#page').innerHTML = `
  <div class="section-title">
    <h2>حضور و غیاب ساعتی</h2>
    <div class="btns">
      <button class="btn" id="exp-csv">${ICONS.download}<span>خروجی اکسل</span></button>
      ${canW('attendance') ? `<button class="btn primary" id="add-bulk">${ICONS.plus}<span>ثبت حضور روز</span></button>` : ''}
    </div>
  </div>
  <div class="card">
    <div class="card-head">
      <div class="filters">
        <label class="f"><label>از تاریخ</label>
          <div class="jdate-wrap"><input type="hidden" id="att-from" data-jdate><div class="jdate-box"><span class="txt ph">انتخاب تاریخ</span><span class="cal-ic">${ICONS.calendar}</span></div></div>
        </label>
        <label class="f"><label>تا تاریخ</label>
          <div class="jdate-wrap"><input type="hidden" id="att-to" data-jdate><div class="jdate-box"><span class="txt ph">انتخاب تاریخ</span><span class="cal-ic">${ICONS.calendar}</span></div></div>
        </label>
        <div class="f"><label>پروژه</label>
          <select class="sel" id="att-project"><option value="">همه</option>${projects.map(p => `<option value="${p.id}">${esc(p.name)}</option>`).join('')}</select>
        </div>
        <div class="f"><label>پیمانکار</label>
          <select class="sel" id="att-contractor"><option value="">همه</option>${contractors.map(c => `<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select>
        </div>
        <button class="btn soft" id="att-filter">اعمال فیلتر</button>
      </div>
    </div>
    <div id="att-list"></div>
  </div>`;
  iPickers($('#page'));
  const load = async () => {
    const sp = new URLSearchParams();
    const from = $('#att-from').value, to = $('#att-to').value;
    if (from) sp.set('from', from);
    if (to) sp.set('to', to);
    if ($('#att-project').value) sp.set('project_id', $('#att-project').value);
    if ($('#att-contractor').value) sp.set('contractor_id', $('#att-contractor').value);
    const rows = await api('GET', '/api/attendance?' + sp.toString());
    const body = rows.map(r => `
      <tr>
        <td class="num">${toFa(r.jdate)}</td>
        <td><b>${esc(r.first_name)} ${esc(r.last_name)}</b></td>
        <td class="num">${toFa(r.person_code)}</td>
        <td>${r.person_type === 'internal' ? '<span class="badge muted">داخلی</span>' : '<span class="badge n">پیمانکار</span>'}</td>
        <td>${esc(r.contractor_name || '—')}</td>
        <td>${esc(r.project_name || '—')}</td>
        <td>${statusBadge(r.status)}</td>
        <td class="num">${r.check_in ? toFa(r.check_in) : '—'}</td>
        <td class="num">${r.check_out ? toFa(r.check_out) : '—'}</td>
        <td class="num">${hoursBetween(r.check_in, r.check_out) !== null && r.status === 'present' ? toFa(hoursBetween(r.check_in, r.check_out)) + ' ساعت' : '—'}</td>
        <td>${esc(r.notes || '')}</td>
        ${canW('attendance') ? `<td class="actions"><button class="icon-btn danger" data-del="${r.id}" title="حذف">${ICONS.trash}</button></td>` : ''}
      </tr>`).join('');
    $('#att-list').innerHTML = tableWrap(
      ['تاریخ', 'نام و نام خانوادگی', 'کد پرسنلی', 'نوع', 'پیمانکار', 'پروژه', 'وضعیت', 'ورود', 'خروج', 'کارکرد', 'توضیحات', ...(canW('attendance') ? [''] : [])],
      body);
    $$('#att-list [data-del]').forEach(b => b.onclick = async () => {
      if (await confirmModal('حذف رکورد', 'این رکورد حضور و غیاب حذف شود؟')) {
        try { await api('DELETE', '/api/attendance/' + b.dataset.del); toast('حذف شد.', 'ok'); load(); } catch (e) { toast(e.message, 'err'); }
      }
    });
  };
  $('#att-filter').onclick = load;
  load();
  $('#exp-csv').onclick = () => {
    const sp = new URLSearchParams();
    const from = $('#att-from').value, to = $('#att-to').value;
    if (from) sp.set('from', from);
    if (to) sp.set('to', to);
    if ($('#att-project').value) sp.set('project_id', $('#att-project').value);
    if ($('#att-contractor').value) sp.set('contractor_id', $('#att-contractor').value);
    window.open('/api/export/attendance?' + sp.toString(), '_blank');
  };
  if (canW('attendance')) $('#add-bulk').onclick = () => bulkAttendanceModal(projects, load);
}

function statusBadge(s) {
  const map = { present: 'ok', absent: 'danger', leave: 'muted', mission: 'n', holiday: 'warn' };
  return `<span class="badge ${map[s] || 'muted'}">${STATUS_FA[s] || s}</span>`;
}


