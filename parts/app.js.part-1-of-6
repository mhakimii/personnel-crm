  { key: 'deliveries', label: 'تحویلات انبار', icon: 'warehouse', path: '#/deliveries', w: 'deliveries' },
  { key: 'reports', label: 'گزارش روزانه', icon: 'reports', path: '#/reports', w: 'reports' },
  { sec: 'پایه‌های اطلاعاتی' },
  { key: 'personnel', label: 'پرسنل', icon: 'personnel', path: '#/personnel', w: 'personnel' },
  { key: 'contractors', label: 'پیمانکاران', icon: 'contractor', path: '#/contractors', w: 'contractors' },
  { key: 'projects', label: 'پروژه‌ها', icon: 'project', path: '#/projects', w: 'projects' },
  { key: 'items', label: 'اقلام انبار', icon: 'items', path: '#/items', w: 'items' },
  { sec: 'مدیریت' },
  { key: 'users', label: 'مدیران و دسترسی‌ها', icon: 'users', path: '#/users' }
];

function renderShell() {
  const hash = location.hash || '#/dashboard';
  const page = hash.split('/')[1] || 'dashboard';
